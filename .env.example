DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: point to a local SentenceTransformer model to run without downloading.
# BOOK_EMBEDDING_MODEL_PATH=D:/models/bge-small-en-v1.5

# Optional: choose a custom Hugging Face cache directory.
# HF_HOME=D:/huggingface-cache

# Optional: use an ASCII-only directory for Chroma on Windows when this project
# is located in a path containing Chinese or other non-ASCII characters.
# BOOK_CHROMA_DB_PATH=D:/chroma_db/semantic-book-recommender

# Optional: bind to all network interfaces for LAN access or deployment.
# GRADIO_SERVER_NAME=0.0.0.0

# Optional: choose a fixed port. Otherwise Gradio selects an available port.
# GRADIO_SERVER_PORT=7860
